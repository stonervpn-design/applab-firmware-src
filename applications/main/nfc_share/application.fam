App(
    appid="nfc_share",
    name="NFC Share",
    apptype=FlipperAppType.MENUEXTERNAL,
    entry_point="nfc_share_app",
    stack_size=4 * 1024,
    icon="A_NFC_14",
    order=54,
    # test/ is a host-only unit test (its own main()); exclude it from the
    # firmware source glob so it never ends up in the ESP32 image. Mirrors
    # the exclude syntax in applications/main/nfc/application.fam ("!cli").
    sources=["*.c*", "!test"],
    fap_libs=["assets"],
)
