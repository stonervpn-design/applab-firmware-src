# TEST-ONLY fragment (not shipped): re-enable octal PSRAM but at 40 MHz to see if
# the lower MSPI speed clears the octal-PSRAM-vs-internal-flash-write hang while
# keeping all 8 MB. Overrides the shipped CONFIG_SPIRAM=n when appended last.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_40M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
