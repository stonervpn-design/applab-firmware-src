# =============================================================================
# M5Stack StickS3 configuration (ESP32-S3-PICO-1-N8R8: 8 MB flash + 8 MB PSRAM)
# Overrides the auto-applied sdkconfig.defaults.esp32s3 (16 MB multiboot) profile.
# =============================================================================

# Flash: 8 MB
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"

# Partition table: 3.5 MB app + 4.4 MB LittleFS "storage" (no SD on this board).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_m5stick_s3.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions_m5stick_s3.csv"

# =============================================================================
# PSRAM — ENABLED (8 MB octal). This is the big win vs the Cardputers: malloc can
# spill to PSRAM, so BLE / WiFi / large buffers have headroom (no RAM starvation).
# =============================================================================
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_SPIRAM_USE_MALLOC=y
# ALWAYSINTERNAL = the LARGEST alloc still forced into internal SRAM; anything
# bigger spills to PSRAM. This was 16384, which forced ~every allocation (<16KB)
# into the scarce 512KB internal SRAM while the 8MB PSRAM sat empty -> internal
# exhausted to ~45KB free, starving RMT/IR TX, BLE TX buffers, etc. (reboots /
# "out of RAM"). 1024 spills all the 1KB..16KB buffers (subghz/BLE/wifi/app) to
# PSRAM as the header comment above intends, leaving internal for DMA/stacks/TCBs.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
# Keep 64KB internal reserved so PSRAM-eligible allocs can never starve the
# internal-only needs (DMA descriptors, task stacks, TCBs, ISRs).
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

CONFIG_BOOTLOADER_VDDSDIO_BOOST_3_3V=y

# =============================================================================
# FreeRTOS
# =============================================================================
CONFIG_FREERTOS_UNICORE=y
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_OPTIMIZED_SCHEDULER=y
CONFIG_FREERTOS_CHECK_STACKOVERFLOW_CANARY=y
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=2048

# =============================================================================
# CPU
# =============================================================================
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240
CONFIG_ESP_MAIN_TASK_STACK_SIZE=3584
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=2048
CONFIG_ESP_TIMER_TASK_STACK_SIZE=2048

# =============================================================================
# Heap
# =============================================================================
CONFIG_HEAP_POISONING_DISABLED=y
CONFIG_HEAP_TRACING_OFF=y
CONFIG_ESP_SYSTEM_ABORT_ON_ALLOC_FAILURE=n

# =============================================================================
# WiFi (defaults are fine with PSRAM; keep modest buffers)
# =============================================================================
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_1=y
CONFIG_ESP_WIFI_IRAM_OPT=y
CONFIG_ESP_WIFI_RX_IRAM_OPT=y

# =============================================================================
# LWIP
# =============================================================================
CONFIG_LWIP_MAX_SOCKETS=8
CONFIG_LWIP_TCPIP_CORE_LOCKING=y

# =============================================================================
# Bluetooth — NimBLE (built-in radio; PSRAM gives it room)
# =============================================================================
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=4096

# =============================================================================
# Newlib / compiler
# =============================================================================
CONFIG_NEWLIB_NANO_FORMAT=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# =============================================================================
# RMT (Infrared)
# =============================================================================
CONFIG_RMT_ISR_IRAM_SAFE=y
CONFIG_RMT_SUPPRESS_DEPRECATE_WARN=y

# =============================================================================
# Console: native USB-Serial-JTAG
# =============================================================================
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# =============================================================================
# TinyUSB (base firmware's USB CDC stack needs this at compile time)
# =============================================================================
CONFIG_TINYUSB_HID_COUNT=3
CONFIG_TINYUSB_DESC_BOS_ENABLED=y
CONFIG_TINYUSB_HID_BUFSIZE=64
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1

# =============================================================================
# Watchdog
# =============================================================================
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_ESP_INT_WDT=y

# Panic coredump to flash (reliable backtrace)
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y

# ---------------------------------------------------------------------------
# Octal-PSRAM XIP vs. runtime flash writes — CRITICAL FIX (M5Stick bootloop).
# The esp32s3 base profile enables SPIRAM_FETCH_INSTRUCTIONS + SPIRAM_RODATA
# (code/rodata executed-in-place FROM the octal PSRAM). On this board that is
# incompatible with writing to internal flash at runtime: a flash write locks
# the shared MSPI bus and disables the cache, so PSRAM-resident code becomes
# unexecutable mid-write and the CPU hard-locks -> TG1WDT_SYS_RST. The desktop
# saving default settings on first boot triggered it, and because the save
# never completed the settings never persisted, so every boot retried and
# re-hung: a permanent bootloop. Keep code/rodata in flash (cached) instead;
# the 8 MB PSRAM is still used for the heap. Overrides the base esp32s3 profile.
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=n
CONFIG_SPIRAM_RODATA=n
