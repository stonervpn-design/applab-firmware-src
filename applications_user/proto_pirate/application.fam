# ProtoPirate 4.0 — ESP32 static port (RX / decode + offline tools).
#
# Upstream ProtoPirate ships each feature as a runtime-loaded .fal PLUGIN: the
# five RX protocol registries, the per-protocol TX encoders, and the shared
# "tool" scenes (config, about, saved-info, sub-decode, brute-force,
# remote-analyzer, welcome). This ESP32 port has NO FAP plugin loader
# (shared_plugin_load in helpers/protopirate_plugins.c is wired to call each
# plugin's compiled-in _ep() directly), so the whole app is built into ONE
# image. Every source is compiled exactly once via the recursive "*.c*" glob;
# the exclusions below drop only what cannot be flattened or what duplicates a
# firmware-provided module.
#
# Enabled and statically wired: RX decoding, the offline sub-decode tool, the PSA
# brute-force tool, the models database, the remote analyzer, and TX/emulate. The
# 23 per-protocol TX encoders ship upstream as tx_<key>.fal built from one shared
# template (single ep symbol, not flattenable); this port defines them once each
# with unique symbols in protocols/plugins/protopirate_tx_static_plugins.c.
# Disabled (see defines.h): the timing tuner and the welcome screen.

App(
    appid="proto_pirate",
    name="ProtoPirate",
    apptype=FlipperAppType.MENUEXTERNAL,
    targets=["all"],
    entry_point="protopirate_app",
    requires=["gui", "subghz"],
    stack_size=4 * 1024,
    fap_description="Decode car key fob signals from Sub-GHz",
    fap_version="4.1",
    fap_icon="images/protopirate_10px.png",
    fap_category="Sub-GHz",
    fap_icon_assets="images",
    fap_file_assets="assets",
    fap_author="RocketGod-git (ProtoPirate) / ESP32 static port",
    # NOTE: PROTOPIRATE_PROTOCOL_RX_ONLY is intentionally NOT set here. Upstream
    # compiles each protocol .c twice (RX-only in registries, TX-only per tx_<key>.fal);
    # this single-image port compiles each .c once, so it must build BOTH halves —
    # decoder and encoder (PROTOPIRATE_WITH_ENCODER, gated in defines.h on emulate).
    cdefines=["PROTOPIRATE_SUB_DECODE_PLUGIN_BUILD", "PROTOPIRATE_BRUTEFORCE_PLUGIN_BUILD", "PROTOPIRATE_REMOTE_ANALYZER_PLUGIN_BUILD", "PROTOPIRATE_CONFIG_PLUGIN_BUILD"],
    sources=[
        # Everything, recursively — compiled once each. Includes the five RX
        # registry plugin .c and every shared tool-scene plugin .c, whose _ep()
        # are called directly by the static loader.
        "*.c*",
        # TX/emulate is ON: scene_emulate.c, emulate_plugin.c and the per-protocol
        # TX plugins (protopirate_tx_static_plugins.c) are all compiled in.
        # --- timing tuner: disabled ---
        "!scenes/protopirate_scene_timing_tuner.c",
        "!scenes/plugins/protopirate_timing_tuner_plugin.c",
        "!protocols/protocol_timings.c",
        # --- welcome screen: disabled (upstream default) ---
        "!scenes/protopirate_scene_welcome.c",
        "!scenes/plugins/protopirate_welcome_plugin.c",
    ],
)
