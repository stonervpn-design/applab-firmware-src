# ProtoPirate — ESP32 static port (RX / decode).
#
# Upstream ProtoPirate is built around fal_embedded PLUGIN modules: each RX
# registry, each TX protocol, and each tool scene ships as a separate .fal ELF
# loaded at runtime by the Flipper plugin manager. This ESP32 port has NO FAP
# plugin loader (plugin_manager is a stub), so the whole app is compiled into a
# single image and the five RX registry plugins are wired statically in
# helpers/protopirate_protocol_plugin_host.c (calls their _ep() directly).
#
# Disabled here (see defines.h): TX/emulate (its 21 protocols are macro-generated
# one-per-plugin from a single source and cannot be flattened into one image) and
# the timing tuner. Decoding of received signals is unaffected. The offline
# sub-decode and PSA brute-force TOOL scenes remain present but are plugin-loaded,
# so on this port they fail to load gracefully (error toast + back) until/unless
# their tool-scene host is also ported to static wiring.

App(
    appid="proto_pirate",
    name="ProtoPirate",
    apptype=FlipperAppType.MENUEXTERNAL,
    targets=["all"],
    entry_point="protopirate_app",
    requires=["gui", "subghz"],
    stack_size=4 * 1024,
    fap_description="Decode car key fob signals from Sub-GHz",
    fap_version="3.2",
    fap_icon="images/protopirate_10px.png",
    fap_category="Sub-GHz",
    fap_icon_assets="images",
    fap_file_assets="keystore",
    fap_author="RocketGod-git (ProtoPirate) / ESP32 static port",
    # TX/emulate is ENABLED and wired statically (see defines.h). Do NOT define
    # PROTOPIRATE_PROTOCOL_RX_ONLY here — that would force PROTOPIRATE_WITH_ENCODER
    # to 0 and compile every encoder out again.
    sources=[
        # Everything, recursively — including the five RX registry plugin .c
        # (protocols/plugins/protopirate_{am,am_vag,fm,fm_f4,fm_honda1}_plugin.c),
        # all decoder/encoder sources, and scenes/plugins/protopirate_emulate_plugin.c
        # (the emulate UI + TX logic, called via its _ep() by the emulate scene).
        "*.c*",
        # PSA brute-force tool-scene plugin is still runtime-loaded (stub loader),
        # so its ELF wrapper stays out; the emulate plugin above is kept in.
        "!scenes/plugins/protopirate_psa_bf_plugin.c",
        # TX protocol plugin template: macro-compiled once-per-protocol on real
        # Flipper via per-instance cdefines; it can't be built a single time here.
        # Replaced by the static protopirate_static_tx_plugin table in
        # helpers/protopirate_protocol_plugin_host.c.
        "!protocols/plugins/protopirate_tx_protocol_plugin.c",
        # Timing tuner disabled.
        "!scenes/protopirate_scene_timing_tuner.c",
        "!protocols/protocol_timings.c",
    ],
)
